# Leave API_BASE_URL empty for demo data, or set the external API URL without /v1.
# URL acessível pelo servidor Next.js, sem o prefixo /v1.
# O navegador usa /api do frontend; esta variável não é pública.
API_BASE_URL=

# Docker Compose: localhost aponta para o próprio container.
# Use aqui a URL externa da API ou um hostname acessível pelo container.
PORT=3000
FOODIST_TAG=local
