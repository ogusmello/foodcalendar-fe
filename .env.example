# Modo atual: apenas demonstração baseada no README do backend.
USE_MOCK_DATA=true

# Opcional: arquivo persistente dos mocks. Sem valor usa .next/cache/foodist-demo-v1.json.
# MOCK_DATA_PATH=/caminho/foodist-demo-v1.json

# API futura, somente com USE_MOCK_DATA=false; endereço acessível pelo Next, sem /v1.
API_BASE_URL=http://localhost:8080

# Docker Compose: porta pública e tag da imagem.
PORT=3000
FOODIST_TAG=local